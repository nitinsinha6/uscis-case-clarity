{
  "manifest_version": 3,
  "name": "USCIS Case Monitor",
  "short_name": "USCIS Monitor",
  "version": "1.0.0",
  "description": "Chrome extension that helps users understand USCIS case API responses.",
  "action": {
    "default_title": "USCIS Case Monitor",
    "default_popup": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://my.uscis.gov/*",
    "https://www.uscis.gov/*"
  ]
}
